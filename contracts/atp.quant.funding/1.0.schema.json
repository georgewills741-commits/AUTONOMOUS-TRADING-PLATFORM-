{
  "$defs": {
    "Amount": {
      "description": "A decimal amount written as a string. A JSON number is refused. At most 34 significant digits; no NaN or infinity.",
      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
      "type": "string"
    },
    "InstrumentType": {
      "description": "An instrument type of PLT-011.",
      "enum": [
        "spot",
        "perpetual",
        "margin"
      ],
      "title": "InstrumentType",
      "type": "string"
    },
    "MarketRef": {
      "additionalProperties": false,
      "description": "A market: its venue, its base and quote assets, its instrument type, and, for a perpetual,\nthe asset it settles in. A margin market trades its spot market's book.",
      "properties": {
        "base": {
          "pattern": "^[A-Z0-9]{1,32}$",
          "title": "Base",
          "type": "string"
        },
        "instrument_type": {
          "$ref": "#/$defs/InstrumentType"
        },
        "quote": {
          "pattern": "^[A-Z0-9]{1,32}$",
          "title": "Quote",
          "type": "string"
        },
        "settle": {
          "anyOf": [
            {
              "pattern": "^[A-Z0-9]{1,32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Settle"
        },
        "venue": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Venue",
          "type": "string"
        }
      },
      "required": [
        "venue",
        "base",
        "quote",
        "instrument_type"
      ],
      "title": "MarketRef",
      "type": "object"
    },
    "PositionSide": {
      "description": "The side of a perpetual position: a long gains as the price rises, a short as it falls.",
      "enum": [
        "long",
        "short"
      ],
      "title": "PositionSide",
      "type": "string"
    }
  },
  "$id": "atp.quant.funding/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The Fee Engine's funding payment for a perpetual position of `notional`, in the quote\nasset, for one funding interval at a published funding rate: the notional times the rate,\nexactly. When the rate is above zero a long position pays it and a short one receives it,\nand the reverse when it is below; `cost` is what the position pays, below zero when it\nreceives. The funding time and interval are the venue's, where it gives them.",
  "properties": {
    "calculation_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Calculation Version",
      "type": "string"
    },
    "cost": {
      "$ref": "#/$defs/Amount"
    },
    "evidence_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Id",
      "type": "string"
    },
    "funding_time_ns": {
      "anyOf": [
        {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Funding Time Ns"
    },
    "inputs": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Inputs",
      "type": "array"
    },
    "interval_seconds": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 9223372036854775807,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Interval Seconds"
    },
    "market": {
      "$ref": "#/$defs/MarketRef"
    },
    "notional": {
      "$ref": "#/$defs/Amount"
    },
    "rate": {
      "$ref": "#/$defs/Amount"
    },
    "side": {
      "$ref": "#/$defs/PositionSide"
    },
    "time_ns": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Time Ns",
      "type": "integer"
    }
  },
  "required": [
    "market",
    "side",
    "notional",
    "rate",
    "cost",
    "funding_time_ns",
    "interval_seconds",
    "time_ns",
    "inputs",
    "calculation_version",
    "evidence_id"
  ],
  "title": "FundingEstimate",
  "type": "object"
}
