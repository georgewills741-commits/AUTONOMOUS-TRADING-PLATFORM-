{
  "$id": "atp.exchange.rate-limit/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One of a venue's limits on requests or messages, under the name its adapter gives it: at\nmost `capacity` units of weight in any `window_ns` nanoseconds, a sliding window.",
  "properties": {
    "capacity": {
      "exclusiveMinimum": 0,
      "maximum": 9223372036854775807,
      "title": "Capacity",
      "type": "integer"
    },
    "name": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Name",
      "type": "string"
    },
    "window_ns": {
      "exclusiveMinimum": 0,
      "maximum": 9223372036854775807,
      "title": "Window Ns",
      "type": "integer"
    }
  },
  "required": [
    "name",
    "capacity",
    "window_ns"
  ],
  "title": "RateLimit",
  "type": "object"
}
