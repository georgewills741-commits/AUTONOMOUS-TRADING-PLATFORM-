{
  "$defs": {
    "Amount": {
      "description": "A decimal amount written as a string. A JSON number is refused. At most 34 significant digits; no NaN or infinity.",
      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
      "type": "string"
    },
    "FeeSchedule": {
      "additionalProperties": false,
      "description": "A venue's published fee schedule for one instrument type, at its base tier: the maker and\ntaker rates, as fractions of the notional (0.001 is 0.1%), the document they are taken from,\nand the date it was read. A maker rate below zero is a rebate.",
      "properties": {
        "as_of": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "As Of",
          "type": "string"
        },
        "instrument_type": {
          "$ref": "#/$defs/InstrumentType"
        },
        "maker": {
          "$ref": "#/$defs/Amount",
          "gt": -1,
          "lt": 1
        },
        "source": {
          "pattern": "^[\\x20-\\x7e]{1,300}$",
          "title": "Source",
          "type": "string"
        },
        "taker": {
          "$ref": "#/$defs/Amount",
          "ge": 0,
          "lt": 1
        }
      },
      "required": [
        "instrument_type",
        "maker",
        "taker",
        "source",
        "as_of"
      ],
      "title": "FeeSchedule",
      "type": "object"
    },
    "InstrumentType": {
      "description": "An instrument type of PLT-011.",
      "enum": [
        "spot",
        "perpetual",
        "margin"
      ],
      "title": "InstrumentType",
      "type": "string"
    },
    "LiquidityRole": {
      "description": "Whether an order adds liquidity to a book (maker) or takes it (taker).",
      "enum": [
        "maker",
        "taker"
      ],
      "title": "LiquidityRole",
      "type": "string"
    },
    "MarketRef": {
      "additionalProperties": false,
      "description": "A market: its venue, its base and quote assets, its instrument type, and, for a perpetual,\nthe asset it settles in. A margin market trades its spot market's book.",
      "properties": {
        "base": {
          "pattern": "^[A-Z0-9]{1,32}$",
          "title": "Base",
          "type": "string"
        },
        "instrument_type": {
          "$ref": "#/$defs/InstrumentType"
        },
        "quote": {
          "pattern": "^[A-Z0-9]{1,32}$",
          "title": "Quote",
          "type": "string"
        },
        "settle": {
          "anyOf": [
            {
              "pattern": "^[A-Z0-9]{1,32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Settle"
        },
        "venue": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Venue",
          "type": "string"
        }
      },
      "required": [
        "venue",
        "base",
        "quote",
        "instrument_type"
      ],
      "title": "MarketRef",
      "type": "object"
    }
  },
  "$id": "atp.quant.fee/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The Fee Engine's fee for an order of `notional`, in the quote asset, in a market of a\nvenue, at the venue's published schedule for the market's instrument type, at its base tier\n(the Stage 2 plan's D8): the notional times the role's rate, exactly; a fee below zero is a\nrebate. It holds the schedule, which names its source and date, and the evidence\nidentifiers of the inputs the notional came from, where it came from any.",
  "properties": {
    "calculation_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Calculation Version",
      "type": "string"
    },
    "evidence_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Id",
      "type": "string"
    },
    "fee": {
      "$ref": "#/$defs/Amount"
    },
    "inputs": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Inputs",
      "type": "array"
    },
    "market": {
      "$ref": "#/$defs/MarketRef"
    },
    "notional": {
      "$ref": "#/$defs/Amount"
    },
    "rate": {
      "$ref": "#/$defs/Amount"
    },
    "role": {
      "$ref": "#/$defs/LiquidityRole"
    },
    "schedule": {
      "$ref": "#/$defs/FeeSchedule"
    },
    "tier": {
      "const": "base",
      "title": "Tier",
      "type": "string"
    }
  },
  "required": [
    "market",
    "role",
    "tier",
    "schedule",
    "notional",
    "rate",
    "fee",
    "inputs",
    "calculation_version",
    "evidence_id"
  ],
  "title": "FeeEstimate",
  "type": "object"
}
