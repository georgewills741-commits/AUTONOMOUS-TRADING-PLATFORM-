{
  "$defs": {
    "DatabaseSettings": {
      "additionalProperties": false,
      "description": "The PostgreSQL database that holds the platform's market data: its host and port, the\ndatabase's name, its user, and the name of the declared server secret that holds the user's\npassword, never the password itself.",
      "properties": {
        "host": {
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$",
          "title": "Host",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z_][a-z0-9_]{0,62}$",
          "title": "Name",
          "type": "string"
        },
        "password_secret": {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Password Secret",
          "type": "string"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "user": {
          "pattern": "^[a-z_][a-z0-9_]{0,62}$",
          "title": "User",
          "type": "string"
        }
      },
      "required": [
        "host",
        "port",
        "name",
        "user",
        "password_secret"
      ],
      "title": "DatabaseSettings",
      "type": "object"
    },
    "Environment": {
      "description": "The six environments of OPS-004.",
      "enum": [
        "development",
        "testing",
        "research",
        "paper",
        "staging",
        "production"
      ],
      "title": "Environment",
      "type": "string"
    },
    "SecretDeclaration": {
      "additionalProperties": false,
      "description": "A secret the environment needs: its name and kind, never its value.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/SecretKind"
        },
        "name": {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "title": "SecretDeclaration",
      "type": "object"
    },
    "SecretKind": {
      "description": "What a declared secret is, from a closed set.",
      "enum": [
        "trading",
        "ai",
        "server"
      ],
      "title": "SecretKind",
      "type": "string"
    }
  },
  "$id": "atp.config.environment/1.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The part that belongs to one environment (MIG-010): its identity, its secrets, its\ndatabase, and the directory of its archive.",
  "properties": {
    "archive_directory": {
      "anyOf": [
        {
          "pattern": "^/[\\x20-\\x7e]{0,1023}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Archive Directory"
    },
    "database": {
      "anyOf": [
        {
          "$ref": "#/$defs/DatabaseSettings"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "environment": {
      "$ref": "#/$defs/Environment"
    },
    "environment_id": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Environment Id",
      "type": "string"
    },
    "secrets": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SecretDeclaration"
      },
      "title": "Secrets",
      "type": "array"
    }
  },
  "required": [
    "environment",
    "environment_id"
  ],
  "title": "EnvironmentConfiguration",
  "type": "object"
}
