{
  "$defs": {
    "Amount": {
      "description": "A decimal amount written as a string. A JSON number is refused. At most 34 significant digits; no NaN or infinity.",
      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
      "type": "string"
    },
    "FeeSchedule": {
      "additionalProperties": false,
      "description": "A venue's published fee schedule for one instrument type, at its base tier: the maker and\ntaker rates, as fractions of the notional (0.001 is 0.1%), the document they are taken from,\nand the date it was read. A maker rate below zero is a rebate.",
      "properties": {
        "as_of": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "As Of",
          "type": "string"
        },
        "instrument_type": {
          "$ref": "#/$defs/InstrumentType"
        },
        "maker": {
          "$ref": "#/$defs/Amount",
          "gt": -1,
          "lt": 1
        },
        "source": {
          "pattern": "^[\\x20-\\x7e]{1,300}$",
          "title": "Source",
          "type": "string"
        },
        "taker": {
          "$ref": "#/$defs/Amount",
          "ge": 0,
          "lt": 1
        }
      },
      "required": [
        "instrument_type",
        "maker",
        "taker",
        "source",
        "as_of"
      ],
      "title": "FeeSchedule",
      "type": "object"
    },
    "InstrumentType": {
      "description": "An instrument type of PLT-011.",
      "enum": [
        "spot",
        "perpetual",
        "margin"
      ],
      "title": "InstrumentType",
      "type": "string"
    },
    "VenueSettings": {
      "additionalProperties": false,
      "description": "A venue whose public market data is monitored: its identifier, the instrument types\nmonitored there, each once, and its published fee schedules, at most one per type monitored.",
      "properties": {
        "fees": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FeeSchedule"
          },
          "title": "Fees",
          "type": "array"
        },
        "instrument_types": {
          "items": {
            "$ref": "#/$defs/InstrumentType"
          },
          "minItems": 1,
          "title": "Instrument Types",
          "type": "array"
        },
        "venue": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Venue",
          "type": "string"
        }
      },
      "required": [
        "venue",
        "instrument_types"
      ],
      "title": "VenueSettings",
      "type": "object"
    }
  },
  "$id": "atp.config.market-data/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The market data the platform monitors: its venues, each once, and the timeframes, in\nseconds, each once, of the bars the Market Regime Engine classifies. Empty, nothing is\nmonitored.",
  "properties": {
    "regime_timeframes_seconds": {
      "default": [],
      "items": {
        "exclusiveMinimum": 0,
        "maximum": 9223372036854775807,
        "type": "integer"
      },
      "title": "Regime Timeframes Seconds",
      "type": "array"
    },
    "venues": {
      "default": [],
      "items": {
        "$ref": "#/$defs/VenueSettings"
      },
      "title": "Venues",
      "type": "array"
    }
  },
  "title": "MarketDataSettings",
  "type": "object"
}
